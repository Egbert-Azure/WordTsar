             <widget class="QRadioButton" name="mSoftSpaceAlwaysOff">
              <property name="text">
               <string>Always O&amp;ff</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="mSoftSpaceWithTags">
              <property name="text">
               <string>Display with Comman&amp;d Tags</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <widget class="QGroupBox" name="mDotCommandsGroup">
           <property name="title">
            <string>Dot Commands</string>
           </property>
           <layout class="QVBoxLayout" name="dotCommandsLayout">
            <item>
             <widget class="QRadioButton" name="mDotAlwaysOn">
              <property name="text">
               <string>&amp;Always On</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QRadioButton" name="mDotWithTags">
              <property name="text">
               <string>Display with Command Ta&amp;gs</string>
              </property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
         <item>
          <spacer name="displayLeftSpacer">
           <property name="orientation"><enum>Qt::Vertical</enum></property>
          </spacer>
         </item>
        </layout>
       </item>

       <!-- Right column: help display + checkboxes -->
       <item>
        <layout class="QVBoxLayout" name="displayRightColumn">
         <property name="leftMargin"><number>10</number></property>
         <item>
          <layout class="QHBoxLayout" name="helpDisplayRow">
           <item>
            <widget class="QLabel" name="labelShowHelp">
             <property name="text"><string>Help Display:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="mShowHelp">
             <item><property name="text"><string>Off (hide status line too)</string></property></item>
             <item><property name="text"><string>Menus Off</string></property></item>
             <item><property name="text"><string>Compact (submenus only)</string></property></item>
             <item><property name="text"><string>Full</string></property></item>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="labelDisplayOnScreen">
           <property name="text"><string>Display On Screen :</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="mShowScrollBar">
           <property name="text"><string>&amp;Scroll Bar</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="mShowRuler">
           <property name="text"><string>&amp;Ruler Line</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="mShowStyleBar">
           <property name="text"><string>S&amp;tyle Bar</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="mShowStatusBar">
           <property name="text"><string>Status Line</string></property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="mShowMenu">
           <property name="text"><string>&amp;Menu Bar</string></property>
          </widget>
         </item>
         <item>
          <spacer name="displayRightSpacer">
           <property name="orientation"><enum>Qt::Vertical</enum></property>
          </spacer>
         </item>
        </layout>
       </item>

      </layout>
     </widget>

     <!-- Tab 6: User -->
     <widget class="QWidget" name="tabUser">
      <attribute name="title">
       <string>User</string>
      </attribute>
      <layout class="QFormLayout" name="userLayout">
       <item row="0" column="0">
        <widget class="QLabel" name="labelShortName">
         <property name="text"><string>Short Name:</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="mShortName"/>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="labelLongName">
         <property name="text"><string>Long Name:</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QLineEdit" name="mLongName"/>
       </item>
      </layout>
     </widget>

    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
